---
import { readFile } from "node:fs/promises";

const file = await readFile("content/pages/home.md", "utf-8");

const title = file.match(/title:\s*(.*)/)?.[1] ?? "";
const subtitle = file.match(/subtitle:\s*(.*)/)?.[1] ?? "";

const body = file
  .replace(/^---[\s\S]*?---/, "")
  .trim();
---

<html>
  <head>
    <title>{title}</title>
  </head>

  <body>
    <h1>{title}</h1>

    <p>{subtitle}</p>

    <div>{body}</div>
  </body>
</html>
