---
import { readFile } from "node:fs/promises";

const file = await readFile("content/pages/home.md", "utf-8");

const titleMatch = file.match(/title:\s*(.*)/);
const title = titleMatch ? titleMatch[1] : "Home";
---

<html>
  <head>
    <title>{title}</title>
  </head>

  <body>
    <h1>{title}</h1>
    <pre>{file}</pre>
  </body>
</html>
