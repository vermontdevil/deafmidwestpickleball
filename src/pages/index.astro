---
import { readFile } from "node:fs/promises";

const file = await readFile("content/pages/home.md", "utf-8");

const title = file.match(/title:\s*["']?(.*?)["']?\n/)?.[1] ?? "Home";

const body = file
  .replace(/^---[\s\S]*?---/, "")
  .trim();
---

<html>
  <head>
    <title>{title}</title>
  </head>

  <body>
    <article>
      <div style="white-space: pre-wrap;">
        {body}
      </div>
    </article>
  </body>
</html>
