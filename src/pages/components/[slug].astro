---
import ContentPage from "../components/ContentPage.astro";

export function getStaticPaths() {
  const pages = import.meta.glob("../../content/pages/*.md", {
    query: "?raw",
    import: "default",
    eager: true,
  });

  return Object.entries(pages).flatMap(([path, markdown]) => {
    const slug = path.split("/").pop().slice(0, -3);
    return slug === "home" ? [] : [{ params: { slug }, props: { markdown } }];
  });
}

const { markdown } = Astro.props;
---

<ContentPage markdown={markdown} currentPath={`/${Astro.params.slug}/`} />
